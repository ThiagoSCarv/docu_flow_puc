{
  "name": "organizadoc",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "certs": "node scripts/gen-certs.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "demo": "npm run build -w web && npm run build -w server && npm run start -w server",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "selfsigned": "5.5.0"
  }
}
