{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/infra/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/infra/http/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/database/migrate.ts",
    "db:seed": "tsx src/infra/database/run-seed.ts",
    "db:seed:demo": "tsx src/infra/database/run-seed.ts --demo"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
